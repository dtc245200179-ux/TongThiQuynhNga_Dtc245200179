# Replace every sample credential before deploying outside your local machine.
POSTGRES_USER=booking_app
POSTGRES_PASSWORD=replace-with-a-unique-long-password
POSTGRES_DB=booking_tour

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-another-unique-long-password

# Optional. Leave empty to create and persist a signing key in PostgreSQL.
# If set, keep the same value across restarts and deployments.
AUTH_TOKEN_SECRET=
